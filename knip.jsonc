{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // The `exports` of the packages point into `dist`, which knip cannot map back to `src` (the build
  // uses another `rootDir` than `tsconfig.json`), so every entry file is listed with its source path.
  "workspaces": {
    ".": {
      // .mcp.json starts it with node -e, which knip does not read
      "ignoreDependencies": ["@mantine/mcp-server"]
    },
    "packages/units": {
      "entry": ["src/index.ts"]
    },
    "packages/locale-format": {
      "entry": ["src/index.ts"]
    },
    "packages/design-tokens": {
      "entry": ["src/index.ts"]
    },
    "packages/ui": {
      "entry": ["src/index.ts", "test/message-ids.ts"],
      // css/ui.css imports it, and knip reads no CSS
      "ignoreDependencies": ["@fontsource-variable/inter"]
    },
    "packages/statistics": {
      "entry": ["src/index.ts"]
    },
    "packages/ballistics": {
      "entry": ["src/index.ts", "scripts/*.mts"]
    },
    "tooling/test-kit": {
      "entry": ["src/index.ts"]
    },
    "packages/schema": {
      "entry": ["src/index.ts"]
    },
    "packages/shot-groups": {
      "entry": ["src/index.ts", "scripts/*.mts"],
      // the event types and target faces of data's records are read by path in the tests, declared so the CI plan tests shot-groups with them
      "ignoreDependencies": ["@rangefoundry/catalog"]
    },
    "packages/importers": {
      "entry": ["src/index.ts"]
    },
    "packages/catalog": {
      "entry": ["src/index.ts", "src/plausibility.ts"]
    },
    "packages/use-cases": {
      "entry": ["src/index.ts", "src/advisory-text.ts", "src/catalog/browser.ts"]
    },
    "packages/target-recognition": {
      "entry": ["src/index.ts", "test/fixtures/target-photos/make.mts"],
      // the target faces of data's records are read by path in the tests, declared so the CI plan tests target-recognition with them
      "ignoreDependencies": ["@rangefoundry/catalog"]
    },
    "packages/svg-drawings": {
      // the bullet records of data are read by path in the tests, declared so the CI plan tests drawing with them
      "ignoreDependencies": ["@rangefoundry/catalog"],
      "entry": [
        "src/index.ts",
        "src/cartridge/index.ts",
        "src/bullet/index.ts",
        "src/seating/index.ts",
        "src/target/index.ts"
      ]
    },
    "packages/cli": {
      "entry": ["src/bin.ts", "scripts/*.mts"]
    },
    "packages/api": {
      "entry": [
        "src/openapi.ts",
        "src/static.ts",
        "src/compute/worker.ts",
        "src/catalogue/write.ts"
      ]
    },
    "apps/docs": {
      // Docusaurus loads these without an import: the sidebars config and the swizzled theme files
      "entry": [
        "sidebars.ts",
        "src/theme/SearchBar.tsx",
        "src/theme/NavbarItem/ComponentTypes.tsx"
      ],
      "ignoreDependencies": [
        // its stylesheet is imported by src/css/custom.css, which knip does not read
        "katex",
        // imported by the examples of the library pages, which scripts/libraries.test.mts runs from this folder
        "@rangefoundry/catalog",
        "@rangefoundry/svg-drawings",
        "@rangefoundry/importers",
        "@rangefoundry/schema",
        // files these name in `Code:` lines and the research log, or that the docs tests import by path, so the CI
        // plan tests the docs when they change
        "@rangefoundry/ballistics",
        "@rangefoundry/cli",
        "@rangefoundry/tools",
        "@rangefoundry/web"
      ]
    },
    "apps/web": {
      "entry": [
        "scripts/glyph-advances.mts",
        "src/service-worker.js",
        // scripts/service-worker.mts copies every export into out/sw.js through a namespace import
        "src/lib/offline.ts"
      ]
    },
    "apps/e2e": {
      // the web app's catalogue is read by path in the unit tests, declared so the CI plan runs them when it changes
      "ignoreDependencies": ["@rangefoundry/web"]
    },
    "tools": {
      // their sources and exports are read by path in the tests, declared so the CI plan tests tools when they change
      "ignoreDependencies": [
        "@rangefoundry/svg-drawings",
        "@rangefoundry/importers",
        "@rangefoundry/web"
      ],
      "ignoreBinaries": [
        // installed in the dev container and the CI image, not from npm
        "oasdiff",
        "schemathesis"
      ]
    }
  }
}
