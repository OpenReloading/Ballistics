{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "resolveJsonModule": true,
    "noEmit": true,
    // nothing here is a library: no declaration check of inferred types (an `analyze()` that returns axe-core's type)
    "declaration": false
  },
  "include": ["playwright.config.ts", "tests", "scripts"]
}
