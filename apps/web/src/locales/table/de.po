msgstr "Der Startdruck liegt über dem Laufwiderstand bei Weg 0 und über dem Zünddruck, und der Einpressdruck bei Weg 0 ist nicht 0; das Geschoss wird daher bis zum Startdruck gehalten und beginnt danach gegen den niedrigeren Laufwiderstand bei Weg 0 zu laufen, anschließend gilt das Einpressprofil."

# en: "The start pressure is at or below the bore resistance at travel 0, so the shot starts when the pressure force exceeds that resistance and the start pressure has no effect."
msgid "coreMessage.warning.startPressureBelowResistance"
msgstr "Der Startdruck liegt auf oder unter dem Laufwiderstand bei Weg 0; der Schuss beginnt daher, wenn die Druckkraft diesen Widerstand übersteigt, und der Startdruck hat keine Wirkung."

# en: "the trace has no positive pressure"
msgid "refusal.traceNoPositivePressure"
msgstr "Die Messkurve enthält keinen positiven Druck"

# en: "the trace never falls to the fall fraction of its peak after the peak"
msgid "refusal.traceNeverFalls"
msgstr "Die Messkurve fällt nach ihrem Höchstwert nie auf den Abfallanteil des Höchstwerts"

# en: "The twist is 0, so the bullet has no rotational energy and the radius of gyration is ignored."
msgid "coreMessage.warning.gyrationRadiusWithoutTwist"
msgstr "Der Drall ist 0, das Geschoss hat daher keine Rotationsenergie und der Trägheitsradius wird ignoriert."

# en: "The upper end of the simulated peak pressure range, {high}, is above {name} {limit} ({spec}; {method}); the nominal value is {nominal}."
msgid "coreMessage.warning.limitExceededUpper"
msgstr "Das obere Ende des simulierten Gasdruckbereichs, {high}, liegt über {name} {limit} ({spec}; {method}); der Nennwert beträgt {nominal}."

# en: "The upper end of the simulated peak pressure range, {high}, is above the typed {name} {limit}; the nominal value is {nominal}."
msgid "coreMessage.warning.typedLimitExceededUpper"
msgstr "Das obere Ende des simulierten Gasdruckbereichs, {high}, liegt über dem eingegebenen {name} {limit}; der Nennwert beträgt {nominal}."

