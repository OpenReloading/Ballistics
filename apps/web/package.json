{
  "name": "@rangefoundry/web",
  "version": "0.0.8",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node -e \"fs.rmSync('.next/cache/fetch-cache', { recursive: true, force: true })\"",
    "build": "next build && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/service-worker.mts",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "check-weight": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-weight.mts",
    "i18n": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/i18n.mts",
    "test": "vitest run --dir test",
    "test:coverage": "vitest run --dir test --coverage"
  },
  "dependencies": {
    "@mantine/core": "catalog:",
    "@mantine/form": "catalog:",
    "@mantine/hooks": "catalog:",
    "@mantine/spotlight": "catalog:",
    "@rangefoundry/api": "workspace:*",
    "@rangefoundry/ballistics": "workspace:*",
    "@rangefoundry/catalog": "workspace:*",
    "@rangefoundry/design-tokens": "workspace:*",
    "@rangefoundry/svg-drawings": "workspace:*",
    "@rangefoundry/importers": "workspace:*",
    "@rangefoundry/locale-format": "workspace:*",
    "@rangefoundry/schema": "workspace:*",
    "@rangefoundry/shot-groups": "workspace:*",
    "@rangefoundry/statistics": "workspace:*",
    "@rangefoundry/target-recognition": "workspace:*",
    "@rangefoundry/units": "workspace:*",
    "@rangefoundry/use-cases": "workspace:*",
    "@phosphor-icons/react": "2.1.10",
    "country-flag-icons": "1.6.20",
    "driver.js": "1.10.2",
    "echarts": "6.1.0",
    "jsqr": "1.4.0",
    "next": "16.4.5",
    "react": "catalog:",
    "react-dom": "catalog:",
    "uqr": "0.1.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "catalog:",
    "fake-indexeddb": "^6.2.7",
    "sharp": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
