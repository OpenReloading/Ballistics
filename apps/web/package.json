{
  "name": "@open-reloading/web",
  "version": "0.0.5",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node -e \"fs.rmSync('.next/cache/fetch-cache', { recursive: true, force: true })\"",
    "build": "next build && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/service-worker.mts",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "check-weight": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-weight.mts",
    "i18n": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/i18n.mts",
    "test": "vitest run --dir test",
    "test:coverage": "vitest run --dir test --coverage"
  },
  "dependencies": {
    "@mantine/core": "9.7.4",
    "@mantine/form": "9.7.4",
    "@mantine/hooks": "9.7.4",
    "@mantine/spotlight": "9.7.4",
    "@open-reloading/api": "workspace:*",
    "@open-reloading/ballistics": "workspace:*",
    "@open-reloading/catalog": "workspace:*",
    "@open-reloading/drawing": "workspace:*",
    "@open-reloading/importers": "workspace:*",
    "@open-reloading/locale-format": "workspace:*",
    "@open-reloading/schema": "workspace:*",
    "@open-reloading/shot-groups": "workspace:*",
    "@open-reloading/statistics": "workspace:*",
    "@open-reloading/units": "workspace:*",
    "@phosphor-icons/react": "2.1.10",
    "country-flag-icons": "1.6.20",
    "driver.js": "1.10.2",
    "echarts": "6.1.0",
    "jsqr": "1.4.0",
    "next": "16.4.2",
    "react": "catalog:",
    "react-dom": "catalog:",
    "uqr": "0.1.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "catalog:",
    "fake-indexeddb": "^6.2.6",
    "sharp": "^0.35.5",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
