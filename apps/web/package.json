{
  "name": "@rangefoundry/web",
  "version": "0.0.7",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "pnpm run lingui:compile && next dev",
    "prebuild": "node -e \"fs.rmSync('.next/cache/fetch-cache', { recursive: true, force: true })\"",
    "build": "pnpm run lingui:compile && next build && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/service-worker.mts",
    "build:start": "pnpm run prerender-list && pnpm run lingui:compile && vite build",
    "start": "next start",
    "typecheck": "lingui check sync --clean --overwrite && pnpm run lingui:compile && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/lingui-outdated.mts && next typegen && tsc --noEmit && tsc --noEmit -p tsconfig.start.json",
    "check-weight": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-weight.mts",
    "prerender-list": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/prerender-list.mts",
    "i18n": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/i18n.mts",
    "lingui:compile": "lingui compile --strict && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/english-catalogs.mts",
    "lingui:de": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/de-to-lingui.mts",
    "test": "pnpm run lingui:compile && vitest run --dir test",
    "test:coverage": "pnpm run lingui:compile && vitest run --dir test --coverage"
  },
  "dependencies": {
    "@lingui/core": "6.12.0",
    "@lingui/react": "6.12.0",
    "@mantine/core": "catalog:",
    "@mantine/form": "catalog:",
    "@mantine/hooks": "catalog:",
    "@mantine/spotlight": "catalog:",
    "@rangefoundry/api": "workspace:*",
    "@rangefoundry/ballistics": "workspace:*",
    "@rangefoundry/catalog": "workspace:*",
    "@rangefoundry/design-tokens": "workspace:*",
    "@rangefoundry/svg-drawings": "workspace:*",
    "@rangefoundry/importers": "workspace:*",
    "@rangefoundry/locale-format": "workspace:*",
    "@rangefoundry/schema": "workspace:*",
    "@rangefoundry/shot-groups": "workspace:*",
    "@rangefoundry/statistics": "workspace:*",
    "@rangefoundry/target-recognition": "workspace:*",
    "@rangefoundry/ui": "workspace:*",
    "@rangefoundry/units": "workspace:*",
    "@rangefoundry/use-cases": "workspace:*",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.7",
    "country-flag-icons": "1.6.20",
    "driver.js": "1.14.0",
    "echarts": "6.1.0",
    "jsqr": "1.4.0",
    "lucide-react": "1.78.0",
    "next": "16.4.6",
    "react": "catalog:",
    "react-dom": "catalog:",
    "uqr": "0.1.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@lingui/cli": "6.12.0",
    "@lingui/conf": "6.12.0",
    "@lingui/format-po": "6.12.0",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "catalog:",
    "fake-indexeddb": "^6.2.8",
    "sharp": "catalog:",
    "typescript": "catalog:",
    "vite": "8.3.8",
    "vitest": "catalog:"
  }
}
