{
  "name": "@open-reloading/web",
  "version": "0.0.4",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node -e \"fs.rmSync('.next/cache/fetch-cache', { recursive: true, force: true })\"",
    "build": "next build && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/service-worker.mts",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "check-weight": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-weight.mts",
    "i18n": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/i18n.mts",
    "test": "vitest run --dir test",
    "test:coverage": "vitest run --dir test --coverage"
  },
  "dependencies": {
    "@mantine/core": "9.7.4",
    "@mantine/form": "9.7.4",
    "@mantine/hooks": "9.7.4",
    "@mantine/spotlight": "9.7.4",
    "@open-reloading/api": "0.0.4",
    "@open-reloading/core": "0.0.3",
    "@open-reloading/data": "0.0.4",
    "@open-reloading/drawing": "0.0.3",
    "@open-reloading/importers": "0.0.4",
    "@open-reloading/schema": "0.0.4",
    "@phosphor-icons/react": "2.1.10",
    "country-flag-icons": "1.6.20",
    "echarts": "6.1.0",
    "jsqr": "1.4.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "uqr": "0.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.5",
    "fake-indexeddb": "^6.2.6",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
