{
  "name": "@open-reloading/docs",
  "version": "0.0.5",
  "private": true,
  "license": "MIT",
  "scripts": {
    "check": "node check.mjs",
    "site:build": "pnpm run site:openapi && pnpm run site:library && pnpm run site:research && docusaurus build",
    "site:research": "node scripts/research-index.mts",
    "site:library": "typedoc",
    "site:openapi": "node scripts/openapi.mts",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/*.test.mts",
    "test:coverage": "mkdir -p coverage && node --test --experimental-test-coverage --test-reporter=lcov --test-reporter-destination=coverage/lcov.info --test-reporter=spec --test-reporter-destination=stdout scripts/*.test.mts"
  },
  "devDependencies": {
    "@docusaurus/theme-common": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@open-reloading/ballistics": "workspace:*",
    "@open-reloading/cli": "workspace:*",
    "@open-reloading/catalog": "workspace:*",
    "@open-reloading/drawing": "workspace:*",
    "@open-reloading/importers": "workspace:*",
    "@open-reloading/schema": "workspace:*",
    "@open-reloading/tools": "workspace:*",
    "@open-reloading/web": "workspace:*",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.0"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/plugin-content-docs": "3.10.2",
    "@docusaurus/plugin-sitemap": "3.10.2",
    "@docusaurus/theme-classic": "3.10.2",
    "@open-reloading/api": "workspace:*",
    "@scalar/api-reference": "1.76.4",
    "katex": "0.19.1",
    "pagefind": "1.6.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0",
    "yaml": "catalog:"
  },
  "browserslist": {
    "production": [
      "last 2 chrome version",
      "last 2 firefox version",
      "last 2 safari version",
      "last 2 edge version"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
