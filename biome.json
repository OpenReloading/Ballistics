{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "maxSize": 2097152,
    "includes": [
      "**",
      "!.claude",
      "!.codex",
      "!.mcp.json",
      "!**/.next",
      "!**/dist",
      "!**/next-env.d.ts",
      "!**/CHANGELOG.md",
      "!**/*.api.md",
      "!tools/test/fixtures/markdown-meaning.md",
      "!pnpm-lock.yaml",
      "!**/test/golden",
      "!packages/design-tokens/css/tokens.css",
      "!packages/design-tokens/src/index.ts",
      "!tools/test/catalog/fixtures/invalid/chrono/broken.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "includes": ["**/*.css", "**/*.json", "**/*.jsonc"],
    "rules": {
      "preset": "recommended",
      "complexity": { "noImportantStyles": "off" },
      "correctness": { "noInvalidGridAreas": "off" },
      "style": { "noDescendingSpecificity": "off" }
    }
  },
  "markdown": {
    "formatter": { "formatEmbeds": false }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "asNeeded"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
