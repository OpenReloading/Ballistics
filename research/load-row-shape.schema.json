{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "maker": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Manufacturer record that publishes the table."
    },
    "cartridgeName": {
      "type": "string",
      "minLength": 1,
      "description": "The cartridge as the table prints it."
    },
    "cartridge": {
      "type": "string",
      "allOf": [
        {
          "pattern": "^(?:catalogue:[a-z0-9]+(?:-[a-z0-9]+)*|user:[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12})$"
        },
        {
          "pattern": "^catalogue:"
        }
      ],
      "description": "Set where a record matches the printed name. Without it the rows have no hold-out split."
    },
    "loads": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "bullet": {
            "type": "object",
            "properties": {
              "printed": {
                "type": "string",
                "minLength": 1,
                "description": "Bullet text as printed: make, type, number."
              },
              "mass": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "description": "In g."
                  },
                  "raw": {
                    "type": "string",
                    "minLength": 1,
                    "description": "The printed value with its unit, as printed."
                  },
                  "assumedUnit": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Unit the value was read in where the source prints none; `value` rests on it."
                  }
                },
                "required": ["value", "raw"],
                "additionalProperties": false
              },
              "record": {
                "type": "string",
                "allOf": [
                  {
                    "pattern": "^(?:catalogue:[a-z0-9]+(?:-[a-z0-9]+)*|user:[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12})$"
                  },
                  {
                    "pattern": "^catalogue:"
                  }
                ],
                "description": "Reference `catalogue:<record id>` to a catalogue bullet."
              }
            },
            "required": ["printed", "mass"],
            "additionalProperties": false
          },
          "powder": {
            "type": "object",
            "properties": {
              "printed": {
                "type": "string",
                "minLength": 1,
                "description": "Powder name as printed."
              },
              "record": {
                "type": "string",
                "allOf": [
                  {
                    "pattern": "^(?:catalogue:[a-z0-9]+(?:-[a-z0-9]+)*|user:[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12})$"
                  },
                  {
                    "pattern": "^catalogue:"
                  }
                ],
                "description": "Reference `catalogue:<record id>` to a catalogue powder."
              }
            },
            "required": ["printed"],
            "additionalProperties": false
          },
          "primer": {
            "type": "string",
            "minLength": 1,
            "description": "Primer as printed, with its size."
          },
          "case": {
            "type": "string",
            "minLength": 1,
            "description": "Case as printed."
          },
          "coal": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "In mm."
              },
              "raw": {
                "type": "string",
                "minLength": 1,
                "description": "The printed value with its unit, as printed."
              },
              "assumedUnit": {
                "type": "string",
                "minLength": 1,
                "description": "Unit the value was read in where the source prints none; `value` rests on it."
              },
              "limit": {
                "type": "string",
                "enum": ["min", "max"],
                "description": "Printed as a limit."
              }
            },
            "required": ["raw"],
            "additionalProperties": false
          },
          "barrel": {
            "type": "object",
            "properties": {
              "length": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "description": "In mm."
                  },
                  "raw": {
                    "type": "string",
                    "minLength": 1,
                    "description": "The printed value with its unit, as printed."
                  },
                  "assumedUnit": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Unit the value was read in where the source prints none; `value` rests on it."
                  }
                },
                "required": ["value", "raw"],
                "additionalProperties": false
              },
              "twist": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "description": "In mm."
                  },
                  "raw": {
                    "type": "string",
                    "minLength": 1,
                    "description": "The printed value with its unit, as printed."
                  },
                  "assumedUnit": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Unit the value was read in where the source prints none; `value` rests on it."
                  }
                },
                "required": ["value", "raw"],
                "additionalProperties": false,
                "description": "Length of one turn: `1:12\"` is 304.8 mm."
              }
            },
            "additionalProperties": false
          },
          "charges": {
            "minItems": 1,
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": ["start", "max", "single", "recommended"],
                  "description": "The lower and the upper figure of a table, a single load, a load of a reduced table."
                },
                "charge": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "description": "In g."
                    },
                    "raw": {
                      "type": "string",
                      "minLength": 1,
                      "description": "The printed value with its unit, as printed."
                    },
                    "assumedUnit": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Unit the value was read in where the source prints none; `value` rests on it."
                    }
                  },
                  "required": ["value", "raw"],
                  "additionalProperties": false
                },
                "velocity": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "description": "In m/s."
                    },
                    "raw": {
                      "type": "string",
                      "minLength": 1,
                      "description": "The printed value with its unit, as printed."
                    },
                    "assumedUnit": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Unit the value was read in where the source prints none; `value` rests on it."
                    },
                    "point": {
                      "type": "object",
                      "properties": {
                        "label": {
                          "type": "string",
                          "minLength": 1,
                          "description": "The symbol the table prints (`v3`, `V5`, `V0`)."
                        },
                        "distance": {
                          "type": "object",
                          "properties": {
                            "value": {
                              "type": "number",
                              "minimum": 0,
                              "description": "In mm."
                            },
                            "raw": {
                              "type": "string",
                              "minLength": 1,
                              "description": "The printed value with its unit, as printed."
                            },
                            "assumedUnit": {
                              "type": "string",
                              "minLength": 1,
                              "description": "Unit the value was read in where the source prints none; `value` rests on it."
                            }
                          },
                          "required": ["value", "raw"],
                          "additionalProperties": false,
                          "description": "Muzzle to the measuring point, where the source defines the symbol."
                        }
                      },
                      "required": ["label"],
                      "additionalProperties": false,
                      "description": "Where the velocity applies. Absent where the table says nothing."
                    }
                  },
                  "required": ["value", "raw"],
                  "additionalProperties": false
                },
                "pressure": {
                  "type": "object",
                  "properties": {
                    "unit": {
                      "type": "string",
                      "enum": ["bar", "psi", "CUP", "LUP"],
                      "description": "Unit the table prints."
                    },
                    "peak": {
                      "type": "object",
                      "properties": {
                        "value": {
                          "type": "number",
                          "exclusiveMinimum": 0,
                          "description": "In bar."
                        },
                        "raw": {
                          "type": "string",
                          "minLength": 1,
                          "description": "The printed value with its unit, as printed."
                        },
                        "assumedUnit": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Unit the value was read in where the source prints none; `value` rests on it."
                        }
                      },
                      "required": ["raw"],
                      "additionalProperties": false
                    },
                    "method": {
                      "type": "string",
                      "enum": ["transducer", "piezo", "crusher", "energy"],
                      "description": "Measuring method."
                    },
                    "methodBasis": {
                      "type": "string",
                      "enum": ["stated", "from-unit"],
                      "description": "`stated`: the source names the method. `from-unit`: read from the unit."
                    }
                  },
                  "required": ["unit", "peak"],
                  "additionalProperties": false
                },
                "marks": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": ["compressed", "do-not-reduce", "subsonic", "reduced-recoil"]
                  },
                  "description": "Marks the table states a meaning for."
                },
                "printedMarks": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": "Marks printed without a stated meaning (`F`, `A`, `*`), as printed."
                }
              },
              "required": ["kind", "charge"],
              "additionalProperties": false
            }
          },
          "page": {
            "type": "string",
            "minLength": 1,
            "description": "Page, anchor or row of the source as printed or linked."
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Deep link to the page or row, where it differs from the source URL."
          }
        },
        "required": ["bullet", "powder", "charges", "page"],
        "additionalProperties": false
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["published", "measured", "derived", "fitted", "computed"],
          "description": "How the values came about."
        },
        "sources": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "description": "Title of the source: the document, or the site and table."
              },
              "publisher": {
                "type": "string",
                "minLength": 1,
                "description": "Who issued the data: a maker, a standards body or the authors."
              },
              "edition": {
                "type": "string",
                "minLength": 1,
                "description": "Edition, print or date as the document states it."
              },
              "page": {
                "type": "string",
                "minLength": 1,
                "description": "Page or section of the document."
              },
              "url": {
                "type": "string",
                "format": "uri",
                "description": "An http or https URL of the source."
              },
              "retrieved": {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
                "description": "Date the source was retrieved, ISO 8601."
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$",
                "description": "SHA-256 of the retrieved file, 64 lowercase hex digits."
              },
              "fields": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "Dot paths of the record fields this source supports. Absent: the whole record."
              },
              "kind": {
                "type": "string",
                "enum": ["published", "measured", "derived", "fitted", "computed"],
                "description": "Kind of this source values when it differs from the provenance kind of the record."
              },
              "license": {
                "type": "string",
                "pattern": "^(LicenseRef-)?[A-Za-z0-9.+-]+$",
                "description": "SPDX id of the license the data is used under, or `LicenseRef-<name>` for the publisher own terms or a written permission described in `terms`."
              },
              "terms": {
                "type": "string",
                "minLength": 1,
                "description": "URL or note of the publisher terms or permission where no SPDX license covers the use. Text starting with http:// or https:// is a link."
              },
              "origin": {
                "type": "string",
                "enum": ["manufacturer", "public", "community"],
                "description": "Who stands behind the source: manufacturer, public or community."
              },
              "run": {
                "type": "object",
                "properties": {
                  "version": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{16}$",
                    "description": "Model version id the report names."
                  },
                  "report": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Report of the evaluation of the fit."
                  }
                },
                "required": ["version", "report"],
                "description": "The fit run behind a `fitted` source."
              },
              "note": {
                "type": "string",
                "minLength": 1,
                "description": "Note on the source."
              }
            },
            "required": ["title"]
          },
          "description": "The sources of the values, at least one."
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "description": "Note on the provenance."
        }
      },
      "required": ["kind", "sources"]
    }
  },
  "required": ["id", "maker", "cartridgeName", "loads", "provenance"],
  "additionalProperties": false
}
