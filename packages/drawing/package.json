{
  "name": "@open-reloading/drawing",
  "version": "0.0.3",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenReloading/Ballistics.git",
    "directory": "packages/drawing"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cartridge": {
      "types": "./dist/cartridge/index.d.ts",
      "default": "./dist/cartridge/index.js"
    },
    "./bullet": {
      "types": "./dist/bullet/index.d.ts",
      "default": "./dist/bullet/index.js"
    },
    "./seating": {
      "types": "./dist/seating/index.d.ts",
      "default": "./dist/seating/index.js"
    },
    "./target": {
      "types": "./dist/target/index.d.ts",
      "default": "./dist/target/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
