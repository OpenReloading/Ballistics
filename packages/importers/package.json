{
  "name": "@rangefoundry/importers",
  "version": "0.0.8",
  "description": "Parsers of chronograph exports, pressure histories and reloading record tables.",
  "keywords": [
    "reloading",
    "ballistics",
    "chronograph",
    "csv",
    "importer"
  ],
  "license": "MIT",
  "homepage": "https://openreloading.github.io/Ballistics/docs/libraries/importers/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenReloading/Ballistics.git",
    "directory": "packages/importers"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/*.tsbuildinfo",
    "!dist/api-extractor",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json && api-extractor run",
    "typecheck": "tsc --noEmit && tsc -p test",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives",
    "test": "vitest run --coverage && publint --strict && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@rangefoundry/schema": "workspace:*",
    "@rangefoundry/statistics": "workspace:*",
    "@rangefoundry/units": "workspace:*"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@microsoft/api-extractor": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "fast-check": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
