{
  "name": "@open-reloading/cli",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "bin": {
    "ballistics": "dist/bin.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "schema": "node src/write-json-schema.ts && biome format --write schema",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@open-reloading/api": "workspace:*",
    "@open-reloading/core": "workspace:*",
    "@open-reloading/data": "workspace:*",
    "@open-reloading/drawing": "workspace:*",
    "@open-reloading/schema": "workspace:*",
    "@open-reloading/units": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "ajv": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
