{
  "color": {
    "$type": "color",
    "select": {
      "$description": "Selection highlight in drawings; no wire color shares it.",
      "$value": { "colorSpace": "srgb", "components": [0.9804, 0.6902, 0.0196], "hex": "#fab005" }
    }
  },
  "radius": {
    "$type": "dimension",
    "default": {
      "$value": { "value": 0, "unit": "px" }
    }
  },
  "space": {
    "$type": "dimension",
    "xs": {
      "$value": { "value": 0.5, "unit": "rem" }
    },
    "sm": {
      "$value": { "value": 0.625, "unit": "rem" }
    },
    "md": {
      "$value": { "value": 1, "unit": "rem" }
    },
    "lg": {
      "$value": { "value": 1.25, "unit": "rem" }
    },
    "xl": {
      "$value": { "value": 2, "unit": "rem" }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "ui": {
        "$value": ["Inter Variable", "system-ui", "sans-serif"]
      },
      "system": {
        "$value": ["system-ui", "sans-serif"]
      }
    },
    "size": {
      "$type": "dimension",
      "xs": {
        "$value": { "value": 0.75, "unit": "rem" }
      },
      "sm": {
        "$value": { "value": 0.8125, "unit": "rem" }
      },
      "md": {
        "$value": { "value": 0.9375, "unit": "rem" }
      },
      "lg": {
        "$value": { "value": 1.0625, "unit": "rem" }
      },
      "xl": {
        "$value": { "value": 1.25, "unit": "rem" }
      }
    },
    "heading": {
      "h1": {
        "size": {
          "$type": "dimension",
          "$value": { "value": 1.5, "unit": "rem" }
        },
        "weight": {
          "$type": "fontWeight",
          "$value": 650
        },
        "line-height": {
          "$type": "number",
          "$value": 1.25
        }
      },
      "h2": {
        "size": {
          "$type": "dimension",
          "$value": { "value": 1.125, "unit": "rem" }
        },
        "weight": {
          "$type": "fontWeight",
          "$value": 600
        },
        "line-height": {
          "$type": "number",
          "$value": 1.3
        }
      },
      "h3": {
        "size": {
          "$type": "dimension",
          "$value": { "value": 1, "unit": "rem" }
        },
        "weight": {
          "$type": "fontWeight",
          "$value": 600
        },
        "line-height": {
          "$type": "number",
          "$value": 1.35
        }
      }
    }
  }
}
