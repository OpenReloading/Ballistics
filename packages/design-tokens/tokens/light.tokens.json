{
  "color": {
    "$type": "color",
    "page": {
      "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" }
    },
    "surface": {
      "$value": { "colorSpace": "srgb", "components": [0.9647, 0.9725, 0.9882], "hex": "#f6f8fc" }
    },
    "surface-alt": {
      "$value": { "colorSpace": "srgb", "components": [0.9333, 0.9412, 0.9647], "hex": "#eef0f6" }
    },
    "ink": {
      "$value": { "colorSpace": "srgb", "components": [0.1137, 0.1294, 0.1882], "hex": "#1d2130" }
    },
    "muted": {
      "$value": { "colorSpace": "srgb", "components": [0.3333, 0.3529, 0.4275], "hex": "#555a6d" }
    },
    "accent": {
      "$value": { "colorSpace": "srgb", "components": [0.098, 0.4431, 0.7608], "hex": "#1971c2" }
    },
    "accent-hover": {
      "$value": { "colorSpace": "srgb", "components": [0.0941, 0.3922, 0.6706], "hex": "#1864ab" }
    },
    "accent-tint": {
      "$value": { "colorSpace": "srgb", "components": [0.9059, 0.9608, 1], "hex": "#e7f5ff" }
    },
    "on-accent": {
      "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" }
    },
    "link": {
      "$value": "{color.accent}"
    },
    "link-hover": {
      "$value": "{color.ink}"
    },
    "line": {
      "$value": { "colorSpace": "srgb", "components": [0.8627, 0.8745, 0.9137], "hex": "#dcdfe9" }
    },
    "control-line": {
      "$value": { "colorSpace": "srgb", "components": [0.4824, 0.498, 0.5686], "hex": "#7b7f91" }
    },
    "warn-text": {
      "$value": { "colorSpace": "srgb", "components": [0.4784, 0.3098, 0], "hex": "#7a4f00" }
    },
    "warn-border": {
      "$value": { "colorSpace": "srgb", "components": [0.8784, 0.7216, 0.2902], "hex": "#e0b84a" }
    },
    "warn-fill": {
      "$value": { "colorSpace": "srgb", "components": [1, 0.9647, 0.8588], "hex": "#fff6db" }
    },
    "error-text": {
      "$value": { "colorSpace": "srgb", "components": [0.7882, 0.1647, 0.1647], "hex": "#c92a2a" }
    }
  }
}
