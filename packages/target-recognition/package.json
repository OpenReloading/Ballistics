{
  "name": "@open-reloading/target-recognition",
  "version": "0.0.0",
  "private": true,
  "description": "Hole proposals on target photos through an inference port, with the raster operations and the blob detector they are built on.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenReloading/Ballistics.git",
    "directory": "packages/target-recognition"
  },
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/*.tsbuildinfo",
    "!dist/api-extractor",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json && api-extractor run",
    "typecheck": "tsc --noEmit && tsc -p test",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives",
    "test": "vitest run --coverage && publint --strict && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@open-reloading/shot-groups": "workspace:*",
    "@open-reloading/statistics": "workspace:*"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@microsoft/api-extractor": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "publint": "catalog:",
    "sharp": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
