{
  "name": "@rangefoundry/use-cases",
  "version": "0.0.0",
  "private": true,
  "description": "The computations the web app, the command line and the API run: input checks, runs and answers, without a framework.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenReloading/Ballistics.git",
    "directory": "packages/use-cases"
  },
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./advisories": {
      "types": "./dist/advisory-text.d.ts",
      "default": "./dist/advisory-text.js"
    },
    "./catalog": {
      "types": "./dist/catalog/browser.d.ts",
      "default": "./dist/catalog/browser.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/*.tsbuildinfo",
    "!dist/api-extractor",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json && api-extractor run",
    "typecheck": "tsc --noEmit && tsc -p test",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives",
    "test": "vitest run --coverage && publint --strict && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@rangefoundry/ballistics": "workspace:*",
    "@open-reloading/catalog": "workspace:*",
    "@rangefoundry/schema": "workspace:*",
    "@rangefoundry/statistics": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@microsoft/api-extractor": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
