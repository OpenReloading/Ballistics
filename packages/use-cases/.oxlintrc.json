{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": ["../oxlint.logic.json"],
  "overrides": [
    {
      "files": ["src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [],
            "patterns": [
              {
                "group": [
                  "@*/*",
                  "@*/*/**",
                  "!@open-reloading/units",
                  "!@open-reloading/units/**",
                  "!@open-reloading/statistics",
                  "!@open-reloading/statistics/**",
                  "!@open-reloading/schema",
                  "!@open-reloading/schema/**",
                  "!@open-reloading/ballistics",
                  "!@open-reloading/ballistics/**",
                  "!@open-reloading/shot-groups",
                  "!@open-reloading/shot-groups/**",
                  "!@open-reloading/catalog",
                  "!@open-reloading/catalog/**",
                  "!@open-reloading/importers",
                  "!@open-reloading/importers/**"
                ],
                "message": "use-cases-imports-logic-only: packages/use-cases has no framework and no I/O: it imports units, statistics, schema, ballistics, shot-groups, catalog, importers, zod and its own files."
              },
              {
                "regex": "^([^.@z]|z([^o]|o([^d]|d[^/])))",
                "message": "use-cases-imports-logic-only: packages/use-cases has no framework and no I/O: it imports units, statistics, schema, ballistics, shot-groups, catalog, importers, zod and its own files."
              },
              {
                "regex": "^(\\.\\./)+[^.]",
                "message": "use-cases-imports-logic-only: packages/use-cases has no framework and no I/O: it imports units, statistics, schema, ballistics, shot-groups, catalog, importers, zod and its own files."
              }
            ]
          }
        ]
      }
    }
  ]
}
