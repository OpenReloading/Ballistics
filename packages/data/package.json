{
  "name": "@open-reloading/data",
  "version": "0.0.4",
  "license": "MIT AND CC-BY-4.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenReloading/Ballistics.git",
    "directory": "packages/data"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plausibility": {
      "types": "./dist/plausibility.d.ts",
      "default": "./dist/plausibility.js"
    },
    "./bundle.json": "./dist/bundle.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "LICENSE",
    "LICENSE-MIT"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node dist/build.js",
    "validate": "node src/validate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@open-reloading/schema": "0.0.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  }
}
