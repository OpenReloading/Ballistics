{
  "name": "@openreloading/data",
  "version": "0.0.1",
  "private": true,
  "license": "MIT AND CC-BY-4.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plausibility": {
      "types": "./dist/plausibility.d.ts",
      "default": "./dist/plausibility.js"
    },
    "./bundle.json": "./dist/bundle.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node dist/build.js",
    "validate": "node src/validate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@openreloading/schema": "*"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  }
}
