{
  "$schema": "https://typedoc.org/schema.json",
  "extends": ["../typedoc.base.json"],
  "entryPoints": [
    "src/app.ts",
    "src/bundle.ts",
    "src/openapi.ts",
    "src/version.ts",
    "src/catalogue/*.ts",
    "src/compute/*.ts",
    "src/routes/*.ts"
  ],
  "tsconfig": "tsconfig.build.json",
  "externalSymbolLinkMappings": { "@open-reloading/schema": { "Provenance": "#" } }
}
