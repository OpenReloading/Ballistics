{
  "name": "@openreloading/api",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    "./openapi": {
      "types": "./dist/openapi.d.ts",
      "default": "./dist/openapi.js"
    },
    "./compute": {
      "types": "./dist/compute/browser.d.ts",
      "default": "./dist/compute/browser.js"
    },
    "./static": {
      "types": "./dist/static.d.ts",
      "default": "./dist/static.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && drizzle-kit export --dialect=postgresql --schema=./src/db/schema.ts --output json > dist/schema.json",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "dev": "node --watch src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/sensible": "^6.0.0",
    "@openreloading/core": "*",
    "@openreloading/data": "*",
    "@openreloading/schema": "*",
    "@scalar/fastify-api-reference": "1.75.1",
    "drizzle-orm": "^1.0.0-rc.4",
    "fastify": "^5.0.0",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^26.0.0",
    "@types/pg": "^8.23.1",
    "ajv": "^8.20.0",
    "drizzle-kit": "^1.0.0-rc.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
