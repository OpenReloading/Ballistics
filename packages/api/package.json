{
  "name": "@open-reloading/api",
  "version": "0.0.7",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    "./openapi": {
      "types": "./dist/openapi.d.ts",
      "default": "./dist/openapi.js"
    },
    "./static": {
      "types": "./dist/static.d.ts",
      "default": "./dist/static.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && node dist/catalogue/write.js",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "dev": "node --watch src/server.ts",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/sensible": "^6.0.7",
    "@rangefoundry/ballistics": "workspace:*",
    "@open-reloading/catalog": "workspace:*",
    "@open-reloading/schema": "workspace:*",
    "@rangefoundry/use-cases": "workspace:*",
    "@scalar/fastify-api-reference": "1.77.0",
    "fastify": "^5.12.8",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@rangefoundry/statistics": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "ajv": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
