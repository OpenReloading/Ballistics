{
  "name": "@open-reloading/catalog",
  "version": "0.0.7",
  "description": "OpenReloading catalogue records as one JSON bundle and the checks they pass.",
  "keywords": [
    "reloading",
    "ballistics",
    "cartridge",
    "bullet",
    "powder"
  ],
  "license": "MIT AND CC-BY-4.0",
  "homepage": "https://openreloading.github.io/Ballistics/docs/libraries/catalog/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenReloading/Ballistics.git",
    "directory": "packages/catalog"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plausibility": {
      "types": "./dist/plausibility.d.ts",
      "default": "./dist/plausibility.js"
    },
    "./bundle.json": "./dist/bundle.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/*.tsbuildinfo",
    "!dist/api-extractor",
    "LICENSE",
    "LICENSE-MIT"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json && api-extractor run && node ../../tools/src/catalog/build.ts",
    "typecheck": "tsc --noEmit && tsc -p test",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives",
    "test": "vitest run --coverage && publint --strict && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@rangefoundry/schema": "workspace:*"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@microsoft/api-extractor": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
