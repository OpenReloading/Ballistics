{
  "name": "@open-reloading/catalog",
  "version": "0.0.5",
  "description": "OpenReloading catalogue records as one JSON bundle, their reader and plausibility checks.",
  "keywords": [
    "reloading",
    "ballistics",
    "cartridge",
    "bullet",
    "powder"
  ],
  "license": "MIT AND CC-BY-4.0",
  "homepage": "https://openreloading.github.io/Ballistics/docs/libraries/catalog/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenReloading/Ballistics.git",
    "directory": "packages/catalog"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plausibility": {
      "types": "./dist/plausibility.d.ts",
      "default": "./dist/plausibility.js"
    },
    "./bundle.json": "./dist/bundle.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "LICENSE",
    "LICENSE-MIT"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node dist/build.js",
    "validate": "node src/validate.ts",
    "loads:merge": "node src/merge-loads.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@open-reloading/schema": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
