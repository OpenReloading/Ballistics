{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "manufacturer": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Name of the product as the manufacturer prints it."
    },
    "productNumber": {
      "type": "string",
      "minLength": 1,
      "description": "Product number."
    },
    "size": {
      "type": "string",
      "enum": [
        "small-rifle",
        "large-rifle",
        "small-pistol",
        "large-pistol",
        "shotshell"
      ],
      "description": "Size class of the primer."
    },
    "magnum": {
      "type": "boolean",
      "description": "Whether the manufacturer sells the primer as a magnum primer."
    },
    "cup": {
      "type": "object",
      "properties": {
        "material": {
          "type": "string",
          "enum": [
            "brass",
            "nickel-plated-brass",
            "copper",
            "steel"
          ],
          "description": "Metal of the cup."
        },
        "thickness": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "In mm."
            },
            "raw": {
              "type": "string",
              "minLength": 1,
              "description": "The value as written in the source, when it differed."
            }
          },
          "required": [
            "value"
          ],
          "unit": "mm",
          "description": "Wall thickness of the cup."
        }
      },
      "additionalProperties": false,
      "description": "The cup of the primer."
    },
    "compound": {
      "type": "string",
      "enum": [
        "lead-styphnate",
        "lead-free"
      ],
      "description": "The priming compound."
    },
    "intendedUse": {
      "type": "string",
      "minLength": 1,
      "description": "What the manufacturer sells the primer for, in the words of this record."
    },
    "performance": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "property": {
            "type": "string",
            "minLength": 1,
            "description": "What the figure describes, as the source names it, for example a drop height."
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "description": "The figure as the source prints it, with its unit."
          }
        },
        "required": [
          "property",
          "value"
        ],
        "additionalProperties": false
      },
      "description": "Output or sensitivity figures the source publishes."
    },
    "note": {
      "type": "string",
      "minLength": 1,
      "description": "Notes on the product."
    },
    "provenance": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "published",
            "measured",
            "derived",
            "fitted",
            "computed"
          ],
          "description": "How the values came about."
        },
        "sources": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "description": "Title of the source: the document, or the site and table."
              },
              "publisher": {
                "type": "string",
                "minLength": 1,
                "description": "Who issued the data: a maker, a standards body or the authors."
              },
              "edition": {
                "type": "string",
                "minLength": 1,
                "description": "Edition, print or date as the document states it."
              },
              "page": {
                "type": "string",
                "minLength": 1,
                "description": "Page or section of the document."
              },
              "url": {
                "type": "string",
                "format": "uri",
                "description": "An http or https URL of the source."
              },
              "retrieved": {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
                "description": "Date the source was retrieved, ISO 8601."
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$",
                "description": "SHA-256 of the retrieved file, 64 lowercase hex digits."
              },
              "fields": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "Dot paths of the record fields this source supports. Absent: the whole record."
              },
              "kind": {
                "type": "string",
                "enum": [
                  "published",
                  "measured",
                  "derived",
                  "fitted",
                  "computed"
                ],
                "description": "Kind of this source values when it differs from the provenance kind of the record."
              },
              "license": {
                "type": "string",
                "pattern": "^(LicenseRef-)?[A-Za-z0-9.+-]+$",
                "description": "SPDX id of the license the data is used under, or `LicenseRef-<name>` for the publisher own terms described in `terms`."
              },
              "terms": {
                "type": "string",
                "minLength": 1,
                "description": "URL or note of the publisher terms where no SPDX license covers the use. Text starting with http:// or https:// is a link."
              },
              "origin": {
                "type": "string",
                "enum": [
                  "manufacturer",
                  "public",
                  "community"
                ],
                "description": "Who stands behind the source: manufacturer, public or community."
              },
              "run": {
                "type": "object",
                "properties": {
                  "version": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{16}$",
                    "description": "Model version id the report names."
                  },
                  "report": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Report of the evaluation of the fit."
                  }
                },
                "required": [
                  "version",
                  "report"
                ],
                "description": "The fit run behind a `fitted` source."
              },
              "note": {
                "type": "string",
                "minLength": 1,
                "description": "Note on the source."
              }
            },
            "required": [
              "title"
            ]
          },
          "description": "The sources of the values, at least one."
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "description": "Note on the provenance."
        }
      },
      "required": [
        "kind",
        "sources"
      ]
    }
  },
  "required": [
    "id",
    "manufacturer",
    "name",
    "size",
    "provenance"
  ],
  "additionalProperties": false
}
