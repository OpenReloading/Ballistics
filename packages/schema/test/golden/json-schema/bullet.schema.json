{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "manufacturer": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "productNumber": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "country": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "productLine": {
      "type": "string",
      "minLength": 1
    },
    "caliber": {
      "type": "string",
      "minLength": 1
    },
    "diameter": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number",
          "description": "In mm."
        },
        "raw": {
          "type": "string",
          "minLength": 1,
          "description": "The value as written in the source, when it differed."
        }
      },
      "required": [
        "value"
      ],
      "unit": "mm"
    },
    "mass": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number",
          "description": "In g."
        },
        "raw": {
          "type": "string",
          "minLength": 1,
          "description": "The value as written in the source, when it differed."
        }
      },
      "required": [
        "value"
      ],
      "unit": "g"
    },
    "length": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number",
          "description": "In mm."
        },
        "raw": {
          "type": "string",
          "minLength": 1,
          "description": "The value as written in the source, when it differed."
        }
      },
      "required": [
        "value"
      ],
      "unit": "mm"
    },
    "base": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "flat",
            "boat-tail",
            "rebated-boat-tail",
            "conical-hollow-base",
            "rounded-hollow-base"
          ]
        },
        "length": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number",
              "description": "In mm."
            },
            "raw": {
              "type": "string",
              "minLength": 1,
              "description": "The value as written in the source, when it differed."
            }
          },
          "required": [
            "value"
          ],
          "unit": "mm"
        },
        "diameter": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "In mm."
            },
            "raw": {
              "type": "string",
              "minLength": 1,
              "description": "The value as written in the source, when it differed."
            }
          },
          "required": [
            "value"
          ],
          "unit": "mm"
        },
        "angle": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 90,
              "description": "In deg."
            },
            "raw": {
              "type": "string",
              "minLength": 1,
              "description": "The value as written in the source, when it differed."
            }
          },
          "required": [
            "value"
          ],
          "unit": "deg"
        },
        "cavityDiameter": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "In mm."
            },
            "raw": {
              "type": "string",
              "minLength": 1,
              "description": "The value as written in the source, when it differed."
            }
          },
          "required": [
            "value"
          ],
          "unit": "mm"
        }
      }
    },
    "ogive": {
      "type": "object",
      "properties": {
        "form": {
          "type": "string",
          "enum": [
            "tangent",
            "secant",
            "hybrid",
            "round-nose",
            "flat-nose"
          ]
        },
        "radius": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "In mm."
            },
            "raw": {
              "type": "string",
              "minLength": 1,
              "description": "The value as written in the source, when it differed."
            }
          },
          "required": [
            "value"
          ],
          "unit": "mm"
        },
        "radiusRatio": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "In 1."
            },
            "raw": {
              "type": "string",
              "minLength": 1,
              "description": "The value as written in the source, when it differed."
            }
          },
          "required": [
            "value"
          ],
          "unit": "1"
        }
      }
    },
    "cannelure": {
      "type": "object",
      "properties": {
        "start": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "In mm."
            },
            "raw": {
              "type": "string",
              "minLength": 1,
              "description": "The value as written in the source, when it differed."
            }
          },
          "required": [
            "value"
          ],
          "unit": "mm"
        },
        "width": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "In mm."
            },
            "raw": {
              "type": "string",
              "minLength": 1,
              "description": "The value as written in the source, when it differed."
            }
          },
          "required": [
            "value"
          ],
          "unit": "mm"
        },
        "depth": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "In mm."
            },
            "raw": {
              "type": "string",
              "minLength": 1,
              "description": "The value as written in the source, when it differed."
            }
          },
          "required": [
            "value"
          ],
          "unit": "mm"
        }
      },
      "required": [
        "start",
        "width"
      ]
    },
    "tip": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "hollow-point",
            "polymer-tip",
            "soft-point",
            "full-metal-jacket",
            "open-meplat"
          ]
        },
        "length": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "In mm."
            },
            "raw": {
              "type": "string",
              "minLength": 1,
              "description": "The value as written in the source, when it differed."
            }
          },
          "required": [
            "value"
          ],
          "unit": "mm"
        },
        "mouthDiameter": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "In mm."
            },
            "raw": {
              "type": "string",
              "minLength": 1,
              "description": "The value as written in the source, when it differed."
            }
          },
          "required": [
            "value"
          ],
          "unit": "mm"
        }
      },
      "required": [
        "type"
      ]
    },
    "meplatDiameter": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0,
          "description": "In mm."
        },
        "raw": {
          "type": "string",
          "minLength": 1,
          "description": "The value as written in the source, when it differed."
        }
      },
      "required": [
        "value"
      ],
      "unit": "mm"
    },
    "noseLength": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number",
          "description": "In mm."
        },
        "raw": {
          "type": "string",
          "minLength": 1,
          "description": "The value as written in the source, when it differed."
        }
      },
      "required": [
        "value"
      ],
      "unit": "mm"
    },
    "baseToOgive": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number",
          "description": "In mm."
        },
        "raw": {
          "type": "string",
          "minLength": 1,
          "description": "The value as written in the source, when it differed."
        }
      },
      "required": [
        "value"
      ],
      "unit": "mm"
    },
    "bearingLength": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number",
          "description": "In mm."
        },
        "raw": {
          "type": "string",
          "minLength": 1,
          "description": "The value as written in the source, when it differed."
        }
      },
      "required": [
        "value"
      ],
      "unit": "mm"
    },
    "construction": {
      "type": "object",
      "properties": {
        "raw": {
          "type": "string",
          "minLength": 1
        },
        "structure": {
          "type": "string",
          "enum": [
            "cup-and-core",
            "bonded",
            "partitioned",
            "monolithic",
            "cast",
            "swaged",
            "plated",
            "frangible"
          ]
        },
        "core": {
          "type": "object",
          "properties": {
            "material": {
              "type": "string",
              "enum": [
                "lead",
                "lead-alloy",
                "copper",
                "copper-alloy",
                "tin",
                "tungsten",
                "steel",
                "compressed-powder"
              ]
            },
            "hardness": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "description": "In 1."
                },
                "raw": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The value as written in the source, when it differed."
                }
              },
              "required": [
                "value"
              ],
              "unit": "1"
            }
          },
          "required": [
            "material"
          ]
        },
        "jacket": {
          "type": "object",
          "properties": {
            "material": {
              "type": "string",
              "enum": [
                "copper",
                "gilding-metal",
                "copper-clad-steel",
                "copper-plated-steel",
                "steel"
              ]
            },
            "thickness": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "description": "In mm."
                },
                "raw": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The value as written in the source, when it differed."
                }
              },
              "required": [
                "value"
              ],
              "unit": "mm"
            }
          }
        },
        "surface": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "moly",
              "black-oxide",
              "powder-coat",
              "polymer-coat",
              "paint",
              "wax-lube",
              "boron-nitride",
              "tungsten-disulfide",
              "copper-wash",
              "lead-wash"
            ]
          }
        },
        "gasCheck": {
          "type": "boolean"
        },
        "drivingBands": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "unmapped": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "raw"
      ]
    },
    "ballisticCoefficients": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "dragModel": {
            "type": "string",
            "enum": [
              "G1",
              "G7"
            ]
          },
          "value": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "minVelocity": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number",
                "description": "In m/s."
              },
              "raw": {
                "type": "string",
                "minLength": 1,
                "description": "The value as written in the source, when it differed."
              }
            },
            "required": [
              "value"
            ],
            "unit": "m/s"
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "dragModel",
          "value"
        ]
      }
    },
    "recommendedTwist": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number",
          "description": "In mm."
        },
        "raw": {
          "type": "string",
          "minLength": 1,
          "description": "The value as written in the source, when it differed."
        }
      },
      "required": [
        "value"
      ],
      "unit": "mm"
    },
    "slowestTwist": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number",
          "description": "In mm."
        },
        "raw": {
          "type": "string",
          "minLength": 1,
          "description": "The value as written in the source, when it differed."
        }
      },
      "required": [
        "value"
      ],
      "unit": "mm"
    },
    "note": {
      "type": "string",
      "minLength": 1
    },
    "nameOnly": {
      "type": "boolean",
      "const": true,
      "description": "A record that only names the bullet: it has no product number."
    },
    "provenance": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "published",
            "measured",
            "derived",
            "fitted",
            "computed"
          ],
          "description": "How the values came about."
        },
        "sources": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "description": "Title of the source: the document, or the site and table."
              },
              "publisher": {
                "type": "string",
                "minLength": 1,
                "description": "Who issued the data: a maker, a standards body or the authors."
              },
              "edition": {
                "type": "string",
                "minLength": 1,
                "description": "Edition, print or date as the document states it."
              },
              "page": {
                "type": "string",
                "minLength": 1,
                "description": "Page or section of the document."
              },
              "url": {
                "type": "string",
                "format": "uri",
                "description": "An http or https URL of the source."
              },
              "retrieved": {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
                "description": "Date the source was retrieved, ISO 8601."
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$",
                "description": "SHA-256 of the retrieved file, 64 lowercase hex digits."
              },
              "fields": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "Dot paths of the record fields this source supports. Absent: the whole record."
              },
              "kind": {
                "type": "string",
                "enum": [
                  "published",
                  "measured",
                  "derived",
                  "fitted",
                  "computed"
                ],
                "description": "Kind of this source values when it differs from the provenance kind of the record."
              },
              "license": {
                "type": "string",
                "pattern": "^(LicenseRef-)?[A-Za-z0-9.+-]+$",
                "description": "SPDX id of the license the data is used under, or `LicenseRef-<name>` for the publisher own terms described in `terms`."
              },
              "terms": {
                "type": "string",
                "minLength": 1,
                "description": "URL or note of the publisher terms where no SPDX license covers the use. Text starting with http:// or https:// is a link."
              },
              "origin": {
                "type": "string",
                "enum": [
                  "manufacturer",
                  "public",
                  "community"
                ],
                "description": "Who stands behind the source: manufacturer, public or community."
              },
              "run": {
                "type": "object",
                "properties": {
                  "version": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{16}$",
                    "description": "Model version id the report names."
                  },
                  "report": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Report of the evaluation of the fit."
                  }
                },
                "required": [
                  "version",
                  "report"
                ],
                "description": "The fit run behind a `fitted` source."
              },
              "note": {
                "type": "string",
                "minLength": 1,
                "description": "Note on the source."
              }
            },
            "required": [
              "title"
            ]
          },
          "description": "The sources of the values, at least one."
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "description": "Note on the provenance."
        }
      },
      "required": [
        "kind",
        "sources"
      ]
    }
  },
  "required": [
    "id",
    "manufacturer",
    "name",
    "mass",
    "provenance"
  ]
}
