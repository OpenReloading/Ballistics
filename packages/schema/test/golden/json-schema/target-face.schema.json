{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "federation": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "rings": {
      "minItems": 2,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "value": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "diameter": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "In mm."
              },
              "raw": {
                "type": "string",
                "minLength": 1,
                "description": "The value as written in the source, when it differed."
              }
            },
            "required": [
              "value"
            ],
            "unit": "mm"
          },
          "height": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "In mm."
              },
              "raw": {
                "type": "string",
                "minLength": 1,
                "description": "The value as written in the source, when it differed."
              }
            },
            "required": [
              "value"
            ],
            "unit": "mm"
          },
          "shape": {
            "type": "string",
            "enum": [
              "circle",
              "square",
              "stadium"
            ]
          },
          "fill": {
            "type": "string",
            "enum": [
              "black",
              "white",
              "grey",
              "red",
              "orange",
              "yellow",
              "green",
              "blue",
              "brown"
            ]
          },
          "line": {
            "type": "string",
            "enum": [
              "black",
              "white",
              "grey",
              "red",
              "orange",
              "yellow",
              "green",
              "blue",
              "brown"
            ]
          }
        },
        "required": [
          "value",
          "diameter"
        ]
      }
    },
    "innerTen": {
      "type": "object",
      "properties": {
        "diameter": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "In mm."
            },
            "raw": {
              "type": "string",
              "minLength": 1,
              "description": "The value as written in the source, when it differed."
            }
          },
          "required": [
            "value"
          ],
          "unit": "mm"
        },
        "height": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "In mm."
            },
            "raw": {
              "type": "string",
              "minLength": 1,
              "description": "The value as written in the source, when it differed."
            }
          },
          "required": [
            "value"
          ],
          "unit": "mm"
        },
        "rule": {
          "type": "string",
          "enum": [
            "touch",
            "cover"
          ]
        }
      },
      "required": [
        "diameter"
      ]
    },
    "blackDiameter": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "In mm."
        },
        "raw": {
          "type": "string",
          "minLength": 1,
          "description": "The value as written in the source, when it differed."
        }
      },
      "required": [
        "value"
      ],
      "unit": "mm"
    },
    "blackHeight": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "In mm."
        },
        "raw": {
          "type": "string",
          "minLength": 1,
          "description": "The value as written in the source, when it differed."
        }
      },
      "required": [
        "value"
      ],
      "unit": "mm"
    },
    "decimal": {
      "type": "boolean"
    },
    "events": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "distance": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "In mm."
              },
              "raw": {
                "type": "string",
                "minLength": 1,
                "description": "The value as written in the source, when it differed."
              }
            },
            "required": [
              "value"
            ],
            "unit": "mm"
          },
          "gauge": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "In mm."
              },
              "raw": {
                "type": "string",
                "minLength": 1,
                "description": "The value as written in the source, when it differed."
              }
            },
            "required": [
              "value"
            ],
            "unit": "mm"
          },
          "scoring": {
            "type": "string",
            "enum": [
              "touch",
              "centre",
              "outward"
            ]
          },
          "federation": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "section": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "enum": [
              "air-rifle",
              "air-pistol",
              "rifle",
              "precision-rifle",
              "service-rifle",
              "lever-action",
              "carbine",
              "pistol",
              "service-pistol",
              "revolver",
              "muzzle-loader"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "distance"
        ],
        "additionalProperties": false
      }
    },
    "paper": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "A2",
            "A3",
            "A4",
            "A5",
            "A6",
            "other"
          ]
        },
        "width": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "In mm."
            },
            "raw": {
              "type": "string",
              "minLength": 1,
              "description": "The value as written in the source, when it differed."
            }
          },
          "required": [
            "value"
          ],
          "unit": "mm"
        },
        "height": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "In mm."
            },
            "raw": {
              "type": "string",
              "minLength": 1,
              "description": "The value as written in the source, when it differed."
            }
          },
          "required": [
            "value"
          ],
          "unit": "mm"
        }
      },
      "required": [
        "width",
        "height"
      ]
    },
    "bulls": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "x": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number",
                "description": "In mm."
              },
              "raw": {
                "type": "string",
                "minLength": 1,
                "description": "The value as written in the source, when it differed."
              }
            },
            "required": [
              "value"
            ],
            "unit": "mm"
          },
          "y": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number",
                "description": "In mm."
              },
              "raw": {
                "type": "string",
                "minLength": 1,
                "description": "The value as written in the source, when it differed."
              }
            },
            "required": [
              "value"
            ],
            "unit": "mm"
          },
          "zone": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "x",
          "y"
        ]
      }
    },
    "numerals": {
      "type": "boolean"
    },
    "photoSearch": {
      "type": "boolean"
    },
    "note": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "published",
            "measured",
            "derived",
            "fitted",
            "computed"
          ],
          "description": "How the values came about."
        },
        "sources": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "description": "Title of the source: the document, or the site and table."
              },
              "publisher": {
                "type": "string",
                "minLength": 1,
                "description": "Who issued the data: a maker, a standards body or the authors."
              },
              "edition": {
                "type": "string",
                "minLength": 1,
                "description": "Edition, print or date as the document states it."
              },
              "page": {
                "type": "string",
                "minLength": 1,
                "description": "Page or section of the document."
              },
              "url": {
                "type": "string",
                "format": "uri",
                "description": "An http or https URL of the source."
              },
              "retrieved": {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
                "description": "Date the source was retrieved, ISO 8601."
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$",
                "description": "SHA-256 of the retrieved file, 64 lowercase hex digits."
              },
              "fields": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "Dot paths of the record fields this source supports. Absent: the whole record."
              },
              "kind": {
                "type": "string",
                "enum": [
                  "published",
                  "measured",
                  "derived",
                  "fitted",
                  "computed"
                ],
                "description": "Kind of this source values when it differs from the provenance kind of the record."
              },
              "license": {
                "type": "string",
                "pattern": "^(LicenseRef-)?[A-Za-z0-9.+-]+$",
                "description": "SPDX id of the license the data is used under, or `LicenseRef-<name>` for the publisher own terms or a written permission described in `terms`."
              },
              "terms": {
                "type": "string",
                "minLength": 1,
                "description": "URL or note of the publisher terms or permission where no SPDX license covers the use. Text starting with http:// or https:// is a link."
              },
              "origin": {
                "type": "string",
                "enum": [
                  "manufacturer",
                  "public",
                  "community"
                ],
                "description": "Who stands behind the source: manufacturer, public or community."
              },
              "run": {
                "type": "object",
                "properties": {
                  "version": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{16}$",
                    "description": "Model version id the report names."
                  },
                  "report": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Report of the evaluation of the fit."
                  }
                },
                "required": [
                  "version",
                  "report"
                ],
                "description": "The fit run behind a `fitted` source."
              },
              "note": {
                "type": "string",
                "minLength": 1,
                "description": "Note on the source."
              }
            },
            "required": [
              "title"
            ]
          },
          "description": "The sources of the values, at least one."
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "description": "Note on the provenance."
        }
      },
      "required": [
        "kind",
        "sources"
      ]
    }
  },
  "required": [
    "id",
    "name",
    "rings",
    "blackDiameter",
    "events",
    "provenance"
  ]
}
