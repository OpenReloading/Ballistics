{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "manufacturer": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "country": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "grainForm": {
      "type": "string",
      "enum": [
        "ball",
        "extruded",
        "flake",
        "other"
      ]
    },
    "propellantBase": {
      "type": "string",
      "enum": [
        "single",
        "double",
        "triple"
      ]
    },
    "bulkDensity": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number",
          "description": "In g/cm3."
        },
        "raw": {
          "type": "string",
          "minLength": 1,
          "description": "The value as written in the source, when it differed."
        }
      },
      "required": [
        "value"
      ],
      "unit": "g/cm3"
    },
    "composition": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "cas": {
            "type": "string",
            "pattern": "^\\d{2,7}-\\d{2}-\\d$"
          },
          "min": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "max": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "raw": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "min",
          "max"
        ],
        "unit": "%"
      }
    },
    "thermochemistry": {
      "type": "object",
      "properties": {
        "loadingDensity": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number",
              "description": "In g/cm3."
            },
            "raw": {
              "type": "string",
              "minLength": 1,
              "description": "The value as written in the source, when it differed."
            }
          },
          "required": [
            "value"
          ],
          "unit": "g/cm3"
        },
        "flameTemperature": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number"
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          },
          "required": [
            "value",
            "min",
            "max"
          ],
          "unit": "K"
        },
        "impetus": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number"
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          },
          "required": [
            "value",
            "min",
            "max"
          ],
          "unit": "J/kg"
        },
        "gamma": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number"
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          },
          "required": [
            "value",
            "min",
            "max"
          ],
          "unit": "1"
        },
        "molarMass": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number"
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          },
          "required": [
            "value",
            "min",
            "max"
          ],
          "unit": "kg/kmol"
        },
        "covolume": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number"
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          },
          "required": [
            "value",
            "min",
            "max"
          ],
          "unit": "m3/kg"
        }
      },
      "required": [
        "loadingDensity",
        "flameTemperature",
        "impetus",
        "gamma",
        "molarMass",
        "covolume"
      ]
    },
    "interior": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "const": "m3"
        },
        "fitted": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "vivacity",
              "energy",
              "form.a"
            ]
          }
        },
        "vivacity": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number"
            },
            "standardUncertainty": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "value"
          ],
          "unit": "1/s"
        },
        "energy": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number"
            },
            "standardUncertainty": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "value"
          ],
          "unit": "J/kg"
        },
        "gamma": {
          "type": "number",
          "exclusiveMinimum": 1
        },
        "covolume": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0,
              "description": "In m3/kg."
            },
            "raw": {
              "type": "string",
              "minLength": 1,
              "description": "The value as written in the source, when it differed."
            }
          },
          "required": [
            "value"
          ],
          "unit": "m3/kg"
        },
        "density": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "In g/cm3."
            },
            "raw": {
              "type": "string",
              "minLength": 1,
              "description": "The value as written in the source, when it differed."
            }
          },
          "required": [
            "value"
          ],
          "unit": "g/cm3"
        },
        "pressureExponent": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "referencePressure": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "In bar."
            },
            "raw": {
              "type": "string",
              "minLength": 1,
              "description": "The value as written in the source, when it differed."
            }
          },
          "required": [
            "value"
          ],
          "unit": "bar"
        },
        "ignitionPressure": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "In bar."
            },
            "raw": {
              "type": "string",
              "minLength": 1,
              "description": "The value as written in the source, when it differed."
            }
          },
          "required": [
            "value"
          ],
          "unit": "bar"
        },
        "startPressure": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0,
              "description": "In bar."
            },
            "raw": {
              "type": "string",
              "minLength": 1,
              "description": "The value as written in the source, when it differed."
            }
          },
          "required": [
            "value"
          ],
          "unit": "bar"
        },
        "propellantTemperature": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number",
              "description": "In degC."
            },
            "raw": {
              "type": "string",
              "minLength": 1,
              "description": "The value as written in the source, when it differed."
            }
          },
          "required": [
            "value"
          ],
          "unit": "degC"
        },
        "burnForm": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "twoStage"
            },
            "a": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number"
                },
                "standardUncertainty": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "value"
              ],
              "unit": "1"
            },
            "m": {
              "type": "number"
            },
            "q": {
              "type": "number",
              "minimum": 0
            },
            "z1": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "kind",
            "a",
            "m",
            "q",
            "z1"
          ]
        },
        "resistance": {
          "type": "object",
          "properties": {
            "stress": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number",
                  "minimum": 0,
                  "description": "In bar."
                },
                "raw": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The value as written in the source, when it differed."
                }
              },
              "required": [
                "value"
              ],
              "unit": "bar"
            },
            "oversize": {
              "type": "number",
              "minimum": 0
            },
            "engraving": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "stress",
            "oversize",
            "engraving"
          ]
        },
        "trainingRows": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "trainingCartridges": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "model",
        "fitted",
        "vivacity",
        "energy",
        "gamma",
        "covolume",
        "density",
        "pressureExponent",
        "referencePressure",
        "ignitionPressure",
        "propellantTemperature",
        "burnForm"
      ]
    },
    "temperatureSensitivity": {
      "type": "object",
      "properties": {
        "reference": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "In K."
            },
            "raw": {
              "type": "string",
              "minLength": 1,
              "description": "The value as written in the source, when it differed."
            }
          },
          "required": [
            "value"
          ],
          "unit": "K"
        },
        "cold": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number",
              "description": "In 1/K."
            },
            "raw": {
              "type": "string",
              "minLength": 1,
              "description": "The value as written in the source, when it differed."
            }
          },
          "required": [
            "value"
          ],
          "unit": "1/K"
        },
        "hot": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number",
              "description": "In 1/K."
            },
            "raw": {
              "type": "string",
              "minLength": 1,
              "description": "The value as written in the source, when it differed."
            }
          },
          "required": [
            "value"
          ],
          "unit": "1/K"
        }
      },
      "required": [
        "reference",
        "cold",
        "hot"
      ]
    },
    "listedCartridges": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "note": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "published",
            "measured",
            "derived",
            "fitted",
            "computed"
          ],
          "description": "How the values came about."
        },
        "sources": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "description": "Title of the source: the document, or the site and table."
              },
              "publisher": {
                "type": "string",
                "minLength": 1,
                "description": "Who issued the data: a maker, a standards body or the authors."
              },
              "edition": {
                "type": "string",
                "minLength": 1,
                "description": "Edition, print or date as the document states it."
              },
              "page": {
                "type": "string",
                "minLength": 1,
                "description": "Page or section of the document."
              },
              "url": {
                "type": "string",
                "format": "uri",
                "description": "An http or https URL of the source."
              },
              "retrieved": {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
                "description": "Date the source was retrieved, ISO 8601."
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$",
                "description": "SHA-256 of the retrieved file, 64 lowercase hex digits."
              },
              "fields": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "Dot paths of the record fields this source supports. Absent: the whole record."
              },
              "kind": {
                "type": "string",
                "enum": [
                  "published",
                  "measured",
                  "derived",
                  "fitted",
                  "computed"
                ],
                "description": "Kind of this source values when it differs from the provenance kind of the record."
              },
              "license": {
                "type": "string",
                "pattern": "^(LicenseRef-)?[A-Za-z0-9.+-]+$",
                "description": "SPDX id of the license the data is used under, or `LicenseRef-<name>` for the publisher own terms or a written permission described in `terms`."
              },
              "terms": {
                "type": "string",
                "minLength": 1,
                "description": "URL or note of the publisher terms or permission where no SPDX license covers the use. Text starting with http:// or https:// is a link."
              },
              "origin": {
                "type": "string",
                "enum": [
                  "manufacturer",
                  "public",
                  "community"
                ],
                "description": "Who stands behind the source: manufacturer, public or community."
              },
              "run": {
                "type": "object",
                "properties": {
                  "version": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{16}$",
                    "description": "Model version id the report names."
                  },
                  "report": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Report of the evaluation of the fit."
                  }
                },
                "required": [
                  "version",
                  "report"
                ],
                "description": "The fit run behind a `fitted` source."
              },
              "note": {
                "type": "string",
                "minLength": 1,
                "description": "Note on the source."
              }
            },
            "required": [
              "title"
            ]
          },
          "description": "The sources of the values, at least one."
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "description": "Note on the provenance."
        }
      },
      "required": [
        "kind",
        "sources"
      ]
    }
  },
  "required": [
    "id",
    "manufacturer",
    "name",
    "provenance"
  ]
}
