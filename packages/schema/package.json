{
  "name": "@open-reloading/schema",
  "version": "0.0.5",
  "description": "Zod schemas, types and stored units of every OpenReloading record kind.",
  "keywords": [
    "reloading",
    "ballistics",
    "schema",
    "zod",
    "units"
  ],
  "license": "MIT",
  "homepage": "https://openreloading.github.io/Ballistics/docs/libraries/schema/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenReloading/Ballistics.git",
    "directory": "packages/schema"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./json-schema/*": "./dist/json-schema/*"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/*.tsbuildinfo",
    "!dist/api-extractor",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json && node scripts/write-json-schema.ts && api-extractor run",
    "typecheck": "tsc --noEmit && tsc -p test",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives",
    "test": "vitest run --coverage && publint --strict && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@open-reloading/units": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@microsoft/api-extractor": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "fast-check": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
