{
  "name": "@open-reloading/schema",
  "version": "0.0.5",
  "description": "Zod schemas, types and stored units of every OpenReloading record kind.",
  "keywords": [
    "reloading",
    "ballistics",
    "schema",
    "zod",
    "units"
  ],
  "license": "MIT",
  "homepage": "https://openreloading.github.io/Ballistics/docs/libraries/schema/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenReloading/Ballistics.git",
    "directory": "packages/schema"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./json-schema/*": "./dist/json-schema/*"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/*.tsbuildinfo",
    "!dist/write-json-schema.*",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json && node dist/write-json-schema.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@open-reloading/units": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
