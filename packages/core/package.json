{
  "name": "@open-reloading/core",
  "version": "0.0.4",
  "description": "Shot-group statistics as pure functions, with the ballistics models, fits and advisories re-exported.",
  "keywords": [
    "reloading",
    "ballistics",
    "interior-ballistics",
    "exterior-ballistics",
    "trajectory"
  ],
  "license": "MIT",
  "homepage": "https://openreloading.github.io/Ballistics/docs/libraries/core/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenReloading/Ballistics.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/*.tsbuildinfo",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage --passWithNoTests"
  },
  "dependencies": {
    "@open-reloading/ballistics": "workspace:*",
    "@open-reloading/statistics": "workspace:*",
    "@open-reloading/units": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
