{
  "name": "@open-reloading/tools",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "api-check": "f=\"${TMPDIR:-/tmp}/openapi.json\" && node src/openapi.ts && oasdiff breaking ../packages/api/openapi.baseline.json \"$f\" --fail-on ERR",
    "api-baseline": "node src/openapi.ts baseline && biome format --write --files-max-size=8388608 ../packages/api/openapi.baseline.json",
    "api-conformance": "f=\"${TMPDIR:-/tmp}/openapi.json\" && node src/openapi.ts && schemathesis run \"$f\" --url \"${API_URL:-http://localhost:3000}\" --checks not_a_server_error,status_code_conformance,content_type_conformance,response_schema_conformance",
    "pages": "node src/pages.ts",
    "pages:serve": "node src/pages-serve.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@open-reloading/api": "*"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
