{
  "name": "@rangefoundry/tools",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    "./catalog": "./src/catalog/records.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "api-check": "f=\"${TMPDIR:-/tmp}/openapi.json\" && TMPDIR=\"${TMPDIR:-/tmp}\" node src/openapi.ts && oasdiff breaking ../packages/api/openapi.baseline.json \"$f\" --fail-on ERR",
    "api-baseline": "node src/openapi.ts baseline && biome format --write --files-max-size=8388608 ../packages/api/openapi.baseline.json",
    "api-conformance": "f=\"${TMPDIR:-/tmp}/openapi.json\" && TMPDIR=\"${TMPDIR:-/tmp}\" node src/openapi.ts && schemathesis run \"$f\" --url \"${API_URL:-http://localhost:3000}\" --checks not_a_server_error,status_code_conformance,content_type_conformance,response_schema_conformance",
    "pages": "node src/pages.ts",
    "pages:serve": "node src/pages-serve.ts",
    "dev:static": "node src/static-dev.ts",
    "pack-check": "node src/pack-check.ts",
    "catalog:validate": "node src/catalog/validate.ts",
    "loads:merge": "node src/catalog/merge-loads.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.include='src/**/*.ts' --coverage.reporter=text-summary --coverage.reporter=lcov"
  },
  "dependencies": {
    "@rangefoundry/api": "workspace:*",
    "@rangefoundry/catalog": "workspace:*",
    "@rangefoundry/schema": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@rangefoundry/svg-drawings": "workspace:*",
    "@rangefoundry/importers": "workspace:*",
    "@rangefoundry/web": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-frontmatter": "2.0.1",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-frontmatter": "2.0.0",
    "micromark-extension-gfm": "3.0.0",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  }
}
