{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "react",
    "jsx-a11y",
    "nextjs",
    "promise",
    "vitest",
    "jest"
  ],
  "categories": {
    "correctness": "off"
  },
  "ignorePatterns": ["**/test/golden/**", "**/next-env.d.ts"],
  "rules": {
    "array-callback-return": "error",
    "complexity": [
      "error",
      {
        "max": 20,
        "variant": "classic"
      }
    ],
    "constructor-super": "error",
    "default-case-last": "error",
    "eqeqeq": [
      "error",
      "always",
      {
        "null": "ignore"
      }
    ],
    "for-direction": "error",
    "getter-return": "error",
    "import/no-cycle": "error",
    "jsx-a11y/alt-text": "error",
    "jsx-a11y/anchor-ambiguous-text": "error",
    "jsx-a11y/anchor-has-content": "error",
    "jsx-a11y/anchor-is-valid": "error",
    "jsx-a11y/aria-activedescendant-has-tabindex": "error",
    "jsx-a11y/aria-props": "error",
    "jsx-a11y/aria-proptypes": "error",
    "jsx-a11y/aria-role": "error",
    "jsx-a11y/aria-unsupported-elements": "error",
    "jsx-a11y/autocomplete-valid": "error",
    "jsx-a11y/click-events-have-key-events": "error",
    "jsx-a11y/heading-has-content": "error",
    "jsx-a11y/html-has-lang": "error",
    "jsx-a11y/iframe-has-title": "error",
    "jsx-a11y/img-redundant-alt": "error",
    "jsx-a11y/interactive-supports-focus": "error",
    "jsx-a11y/label-has-associated-control": "error",
    "jsx-a11y/lang": "error",
    "jsx-a11y/media-has-caption": "error",
    "jsx-a11y/mouse-events-have-key-events": "error",
    "jsx-a11y/no-access-key": "error",
    "jsx-a11y/no-aria-hidden-on-focusable": "error",
    "jsx-a11y/no-autofocus": "error",
    "jsx-a11y/no-distracting-elements": "error",
    "jsx-a11y/no-interactive-element-to-noninteractive-role": "error",
    "jsx-a11y/no-noninteractive-element-to-interactive-role": "error",
    "jsx-a11y/no-noninteractive-tabindex": "error",
    "jsx-a11y/no-redundant-roles": "error",
    "jsx-a11y/no-static-element-interactions": "error",
    "jsx-a11y/role-has-required-aria-props": "error",
    "jsx-a11y/role-supports-aria-props": "error",
    "jsx-a11y/scope": "error",
    "jsx-a11y/tabindex-no-positive": "error",
    "nextjs/google-font-display": "error",
    "no-array-constructor": "error",
    "no-async-promise-executor": "error",
    "no-case-declarations": "error",
    "no-class-assign": "error",
    "no-compare-neg-zero": "error",
    "no-cond-assign": ["error", "always"],
    "no-const-assign": "error",
    "no-constant-condition": "error",
    "no-constructor-return": "error",
    "no-control-regex": "error",
    "no-debugger": "error",
    "no-dupe-class-members": "error",
    "no-dupe-else-if": "error",
    "no-dupe-keys": "error",
    "no-duplicate-case": "error",
    "no-empty-character-class": "error",
    "no-empty-pattern": "error",
    "no-eval": "error",
    "no-ex-assign": "error",
    "no-extra-boolean-cast": "error",
    "no-extra-label": "error",
    "no-fallthrough": "error",
    "no-func-assign": "error",
    "no-global-assign": "error",
    "no-import-assign": "error",
    "no-inner-declarations": "error",
    "no-irregular-whitespace": "error",
    "no-label-var": "error",
    "no-labels": [
      "error",
      {
        "allowLoop": true
      }
    ],
    "no-lone-blocks": "error",
    "no-loss-of-precision": "error",
    "no-misleading-character-class": "error",
    "no-new-native-nonconstructor": "error",
    "no-nonoctal-decimal-escape": "error",
    "no-obj-calls": "error",
    "no-param-reassign": "error",
    "no-proto": "error",
    "no-prototype-builtins": "error",
    "no-redeclare": "error",
    "no-regex-spaces": "error",
    "no-script-url": "error",
    "no-self-assign": "error",
    "no-self-compare": "error",
    "no-sequences": "error",
    "no-setter-return": "error",
    "no-shadow-restricted-names": "error",
    "no-sparse-arrays": "error",
    "no-template-curly-in-string": "error",
    "no-this-before-super": "error",
    "no-unneeded-ternary": "error",
    "no-unreachable": "error",
    "no-unsafe-finally": "error",
    "no-unsafe-negation": "error",
    "no-unsafe-optional-chaining": "error",
    "no-unused-expressions": "error",
    "no-unused-labels": "error",
    "no-unused-private-class-members": "error",
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrors": "none",
        "ignoreRestSiblings": true
      }
    ],
    "no-use-before-define": [
      "error",
      {
        "functions": false,
        "classes": false,
        "variables": false,
        "typedefs": false,
        "ignoreTypeReferences": true
      }
    ],
    "no-useless-backreference": "error",
    "no-useless-catch": "error",
    "no-useless-constructor": "error",
    "no-useless-escape": "error",
    "no-useless-rename": "error",
    "no-with": "error",
    "oxc/approx-constant": "error",
    "oxc/bad-min-max-func": "error",
    "oxc/misrefactored-assign-op": "error",
    "oxc/no-accumulating-spread": "error",
    "oxc/no-const-enum": "error",
    "prefer-arrow-callback": [
      "error",
      {
        "allowNamedFunctions": true
      }
    ],
    "prefer-const": "error",
    "prefer-exponentiation-operator": "error",
    "prefer-numeric-literals": "error",
    "prefer-regex-literals": "error",
    "prefer-rest-params": "error",
    "prefer-template": "error",
    "promise/no-nesting": "error",
    "radix": "error",
    "react/button-has-type": "error",
    "react/jsx-no-comment-textnodes": "error",
    "react/jsx-no-duplicate-props": "error",
    "react/jsx-no-target-blank": "error",
    "react/jsx-no-useless-fragment": "error",
    "react/void-dom-elements-no-children": "error",
    "require-yield": "error",
    "typescript/adjacent-overload-signatures": "error",
    "typescript/ban-ts-comment": "error",
    "typescript/ban-types": "error",
    "typescript/consistent-type-imports": [
      "error",
      {
        "disallowTypeAnnotations": false
      }
    ],
    "typescript/no-duplicate-enum-values": "error",
    "typescript/no-empty-interface": [
      "error",
      {
        "allowSingleExtends": true
      }
    ],
    "typescript/no-explicit-any": "error",
    "typescript/no-extra-non-null-assertion": "error",
    "typescript/no-import-type-side-effects": "error",
    "typescript/no-invalid-void-type": "error",
    "typescript/no-misused-new": "error",
    "typescript/no-non-null-asserted-optional-chain": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-this-alias": "error",
    "typescript/no-unnecessary-type-constraint": "error",
    "typescript/no-unsafe-declaration-merging": "error",
    "typescript/no-useless-empty-export": "error",
    "typescript/prefer-for-of": "error",
    "typescript/prefer-function-type": "error",
    "typescript/prefer-literal-enum-member": "error",
    "typescript/prefer-namespace-keyword": "error",
    "unicorn/no-document-cookie": "error",
    "unicorn/no-instanceof-array": "error",
    "unicorn/no-static-only-class": "error",
    "unicorn/no-thenable": "error",
    "unicorn/no-useless-switch-case": "error",
    "unicorn/no-useless-undefined": [
      "error",
      {
        "checkArguments": false,
        "checkArrowFunctionBody": false
      }
    ],
    "unicorn/prefer-array-flat-map": "error",
    "unicorn/prefer-array-index-of": "error",
    "unicorn/prefer-date-now": "error",
    "unicorn/prefer-dom-node-text-content": "error",
    "unicorn/prefer-math-min-max": "error",
    "unicorn/prefer-node-protocol": "error",
    "unicorn/prefer-number-properties": [
      "error",
      {
        "checkNaN": false
      }
    ],
    "use-isnan": "error",
    "valid-typeof": "error"
  },
  "overrides": [
    {
      "files": ["apps/web/**", "apps/docs/**"],
      "rules": {
        "nextjs/google-font-preconnect": "error",
        "nextjs/inline-script-id": "error",
        "nextjs/no-before-interactive-script-outside-document": "error",
        "nextjs/no-document-import-in-page": "error",
        "nextjs/no-head-element": "error",
        "nextjs/no-head-import-in-document": "error",
        "nextjs/no-img-element": "error",
        "nextjs/no-unwanted-polyfillio": "error",
        "react/exhaustive-deps": "error",
        "react/jsx-key": "error",
        "react/no-array-index-key": "error",
        "react/no-children-prop": "error",
        "react/no-danger": "error",
        "react/no-danger-with-children": "error",
        "react/no-namespace": "error",
        "react/no-render-return-value": "error",
        "react/no-string-refs": "error",
        "react/rules-of-hooks": "error"
      }
    },
    {
      "files": ["**/test/**", "**/*.test.ts", "**/*.test.tsx", "**/*.test.mts", "apps/e2e/**"],
      "rules": {
        "unicorn/prefer-dom-node-text-content": "off",
        "no-script-url": "off",
        "vitest/no-focused-tests": "error",
        "vitest/no-duplicate-hooks": "error",
        "vitest/no-identical-title": "error",
        "jest/no-export": "error"
      }
    },
    {
      "files": ["packages/core/src/**", "packages/importers/src/**", "packages/drawing/src/**"],
      "rules": {
        "no-restricted-globals": [
          "error",
          {
            "name": "window",
            "message": "logic-no-dom: units, schema, core, importers and drawing run anywhere, so they read no browser global."
          },
          {
            "name": "document",
            "message": "logic-no-dom: units, schema, core, importers and drawing run anywhere, so they read no browser global."
          },
          {
            "name": "navigator",
            "message": "logic-no-dom: units, schema, core, importers and drawing run anywhere, so they read no browser global."
          },
          {
            "name": "location",
            "message": "logic-no-dom: units, schema, core, importers and drawing run anywhere, so they read no browser global."
          },
          {
            "name": "localStorage",
            "message": "logic-no-dom: units, schema, core, importers and drawing run anywhere, so they read no browser global."
          },
          {
            "name": "sessionStorage",
            "message": "logic-no-dom: units, schema, core, importers and drawing run anywhere, so they read no browser global."
          },
          {
            "name": "indexedDB",
            "message": "logic-no-dom: units, schema, core, importers and drawing run anywhere, so they read no browser global."
          },
          {
            "name": "HTMLElement",
            "message": "logic-no-dom: units, schema, core, importers and drawing run anywhere, so they read no browser global."
          },
          {
            "name": "Element",
            "message": "logic-no-dom: units, schema, core, importers and drawing run anywhere, so they read no browser global."
          },
          {
            "name": "requestAnimationFrame",
            "message": "logic-no-dom: units, schema, core, importers and drawing run anywhere, so they read no browser global."
          },
          {
            "name": "getComputedStyle",
            "message": "logic-no-dom: units, schema, core, importers and drawing run anywhere, so they read no browser global."
          },
          {
            "name": "matchMedia",
            "message": "logic-no-dom: units, schema, core, importers and drawing run anywhere, so they read no browser global."
          },
          {
            "name": "alert",
            "message": "logic-no-dom: units, schema, core, importers and drawing run anywhere, so they read no browser global."
          }
        ]
      }
    },
    {
      "files": ["packages/core/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [],
            "patterns": [
              {
                "group": [
                  "@*/*",
                  "@*/*/**",
                  "!@open-reloading/units",
                  "!@open-reloading/units/**",
                  "!@open-reloading/statistics",
                  "!@open-reloading/statistics/**"
                ],
                "message": "core-imports-units-and-statistics: packages/core has no I/O: it imports only @open-reloading/units, @open-reloading/statistics and its own files."
              },
              {
                "regex": "^[^.@]",
                "message": "core-imports-units-and-statistics: packages/core has no I/O: it imports only @open-reloading/units, @open-reloading/statistics and its own files."
              },
              {
                "regex": "^(\\.\\./)+((units|statistics|schema|importers|core|data|api|drawing|cli)/(src|dist)|packages|apps)/",
                "message": "core-imports-units-and-statistics: packages/core has no I/O: it imports only @open-reloading/units, @open-reloading/statistics and its own files."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/drawing/src/*.ts", "packages/drawing/src/core/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [],
            "patterns": [
              {
                "group": ["@*/*", "@*/*/**"],
                "message": "drawing-core-imports: packages/drawing has no I/O, no React, DOM or Next.js. Its core folder imports only the folders core."
              },
              {
                "regex": "^[^.@]",
                "message": "drawing-core-imports: packages/drawing has no I/O, no React, DOM or Next.js. Its core folder imports only the folders core."
              },
              {
                "regex": "^(\\.\\./)+((units|schema|importers|core|data|api|drawing|cli)/(src|dist)|packages|apps)/",
                "message": "drawing-core-imports: packages/drawing has no I/O, no React, DOM or Next.js. Its core folder imports only the folders core."
              },
              {
                "regex": "^(\\./|(\\.\\./)+)(cartridge|bullet|seating|target)/",
                "message": "drawing-core-imports: packages/drawing has no I/O, no React, DOM or Next.js. Its core folder imports only the folders core."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/drawing/src/cartridge/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [],
            "patterns": [
              {
                "group": ["@*/*", "@*/*/**"],
                "message": "drawing-cartridge-imports: packages/drawing has no I/O, no React, DOM or Next.js. Its cartridge folder imports only the folders core, cartridge."
              },
              {
                "regex": "^[^.@]",
                "message": "drawing-cartridge-imports: packages/drawing has no I/O, no React, DOM or Next.js. Its cartridge folder imports only the folders core, cartridge."
              },
              {
                "regex": "^(\\.\\./)+((units|schema|importers|core|data|api|drawing|cli)/(src|dist)|packages|apps)/",
                "message": "drawing-cartridge-imports: packages/drawing has no I/O, no React, DOM or Next.js. Its cartridge folder imports only the folders core, cartridge."
              },
              {
                "regex": "^(\\.\\./)+(bullet|seating|target)/",
                "message": "drawing-cartridge-imports: packages/drawing has no I/O, no React, DOM or Next.js. Its cartridge folder imports only the folders core, cartridge."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/drawing/src/bullet/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [],
            "patterns": [
              {
                "group": ["@*/*", "@*/*/**"],
                "message": "drawing-bullet-imports: packages/drawing has no I/O, no React, DOM or Next.js. Its bullet folder imports only the folders core, bullet."
              },
              {
                "regex": "^[^.@]",
                "message": "drawing-bullet-imports: packages/drawing has no I/O, no React, DOM or Next.js. Its bullet folder imports only the folders core, bullet."
              },
              {
                "regex": "^(\\.\\./)+((units|schema|importers|core|data|api|drawing|cli)/(src|dist)|packages|apps)/",
                "message": "drawing-bullet-imports: packages/drawing has no I/O, no React, DOM or Next.js. Its bullet folder imports only the folders core, bullet."
              },
              {
                "regex": "^(\\.\\./)+(cartridge|seating|target)/",
                "message": "drawing-bullet-imports: packages/drawing has no I/O, no React, DOM or Next.js. Its bullet folder imports only the folders core, bullet."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/drawing/src/seating/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [],
            "patterns": [
              {
                "group": ["@*/*", "@*/*/**"],
                "message": "drawing-seating-imports: packages/drawing has no I/O, no React, DOM or Next.js. Its seating folder imports only the folders core, cartridge, bullet, seating."
              },
              {
                "regex": "^[^.@]",
                "message": "drawing-seating-imports: packages/drawing has no I/O, no React, DOM or Next.js. Its seating folder imports only the folders core, cartridge, bullet, seating."
              },
              {
                "regex": "^(\\.\\./)+((units|schema|importers|core|data|api|drawing|cli)/(src|dist)|packages|apps)/",
                "message": "drawing-seating-imports: packages/drawing has no I/O, no React, DOM or Next.js. Its seating folder imports only the folders core, cartridge, bullet, seating."
              },
              {
                "regex": "^(\\.\\./)+target/",
                "message": "drawing-seating-imports: packages/drawing has no I/O, no React, DOM or Next.js. Its seating folder imports only the folders core, cartridge, bullet, seating."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/drawing/src/target/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [],
            "patterns": [
              {
                "group": ["@*/*", "@*/*/**"],
                "message": "drawing-target-imports: packages/drawing has no I/O, no React, DOM or Next.js. Its target folder imports only the folders target."
              },
              {
                "regex": "^[^.@]",
                "message": "drawing-target-imports: packages/drawing has no I/O, no React, DOM or Next.js. Its target folder imports only the folders target."
              },
              {
                "regex": "^(\\.\\./)+((units|schema|importers|core|data|api|drawing|cli)/(src|dist)|packages|apps)/",
                "message": "drawing-target-imports: packages/drawing has no I/O, no React, DOM or Next.js. Its target folder imports only the folders target."
              },
              {
                "regex": "^((\\.\\./)+(core|cartridge|bullet|seating)/|\\.\\./[^/]+$)",
                "message": "drawing-target-imports: packages/drawing has no I/O, no React, DOM or Next.js. Its target folder imports only the folders target."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/importers/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@open-reloading/schema",
                "allowTypeImports": true,
                "message": "importers-schema-for-types-only: packages/importers uses @open-reloading/schema for types only."
              }
            ],
            "patterns": [
              {
                "group": ["@*/*", "@*/*/**", "!@open-reloading/schema"],
                "message": "importers-imports-schema-only: packages/importers has no I/O and imports nothing but @open-reloading/schema and its own files."
              },
              {
                "regex": "^[^.@]",
                "message": "importers-imports-schema-only: packages/importers has no I/O and imports nothing but @open-reloading/schema and its own files."
              },
              {
                "regex": "^(\\.\\./)+((units|schema|importers|core|data|api|drawing|cli)/(src|dist)|packages|apps)/",
                "message": "importers-imports-schema-only: packages/importers has no I/O and imports nothing but @open-reloading/schema and its own files."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/data/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [],
            "patterns": [
              {
                "group": [
                  "@open-reloading/*",
                  "@open-reloading/*/**",
                  "!@open-reloading/schema",
                  "!@open-reloading/schema/**"
                ],
                "message": "data-imports-schema-only: packages/data depends on @open-reloading/schema alone."
              },
              {
                "regex": "^(\\.\\./)+((units|schema|importers|core|data|api|drawing|cli)/(src|dist)|packages|apps)/",
                "message": "data-imports-schema-only: packages/data depends on @open-reloading/schema alone."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/api/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [],
            "patterns": [
              {
                "group": [
                  "@open-reloading/*",
                  "@open-reloading/*/**",
                  "!@open-reloading/core",
                  "!@open-reloading/core/**",
                  "!@open-reloading/data",
                  "!@open-reloading/data/**",
                  "!@open-reloading/schema",
                  "!@open-reloading/schema/**"
                ],
                "message": "api-imports-core-data-schema-only: packages/api depends on core, data and schema."
              },
              {
                "regex": "^(\\.\\./)+((units|schema|importers|core|data|api|drawing|cli)/(src|dist)|packages|apps)/",
                "message": "api-imports-core-data-schema-only: packages/api depends on core, data and schema."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/cli/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [],
            "patterns": [
              {
                "group": [
                  "@open-reloading/*",
                  "@open-reloading/*/**",
                  "!@open-reloading/core",
                  "!@open-reloading/core/**",
                  "!@open-reloading/data",
                  "!@open-reloading/data/**",
                  "!@open-reloading/drawing",
                  "!@open-reloading/drawing/**",
                  "!@open-reloading/schema",
                  "!@open-reloading/schema/**",
                  "!@open-reloading/api/compute",
                  "!@open-reloading/api/catalogue"
                ],
                "message": "cli-imports-core-data-drawing-schema-only: packages/cli is a thin layer over the libraries: core, data, drawing and schema, and of @open-reloading/api only the compute and catalogue entries the browser runs."
              },
              {
                "regex": "^(\\.\\./)+((units|schema|importers|core|data|api|drawing|cli)/(src|dist)|packages|apps)/",
                "message": "cli-imports-core-data-drawing-schema-only: packages/cli is a thin layer over the libraries: core, data, drawing and schema, and of @open-reloading/api only the compute and catalogue entries the browser runs."
              }
            ]
          }
        ]
      }
