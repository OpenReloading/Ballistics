{
  "name": "openreloading",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "lint": "oxlint --format default --ignore-pattern \"packages/units/**\" --ignore-pattern \"packages/schema/**\" --deny-warnings --report-unused-disable-directives && biome check --error-on-warnings . && pnpm --filter @open-reloading/units --filter @open-reloading/schema run lint",
    "format": "biome check --write .",
    "build": "pnpm --filter \"./packages/*\" run build",
    "typecheck": "pnpm --recursive --workspace-concurrency=1 run typecheck",
    "test": "pnpm --recursive --workspace-concurrency=1 --filter \"!@open-reloading/e2e\" run test && pnpm --filter @open-reloading/e2e run test:unit",
    "test:e2e": "pnpm --filter @open-reloading/e2e run test",
    "e2e:smoke": "pnpm --filter @open-reloading/e2e run smoke",
    "pages:build": "pnpm --filter @open-reloading/tools run pages",
    "pages:serve": "pnpm --filter @open-reloading/tools run pages:serve",
    "dev:static": "pnpm --filter @open-reloading/tools run dev:static",
    "static:build": "pnpm --filter @open-reloading/tools run pages --sample",
    "data:validate": "pnpm --filter @open-reloading/data run validate",
    "api:check": "pnpm --filter @open-reloading/tools run api-check",
    "api:conformance": "pnpm --filter @open-reloading/tools run api-conformance",
    "baselines": "pnpm --filter @open-reloading/schema --filter @open-reloading/web --filter @open-reloading/tools exec vitest run test/contracts.test.ts --update",
    "knip": "knip",
    "pack:check": "pnpm --filter @open-reloading/tools run pack-check",
    "docs:check": "pnpm --filter @open-reloading/docs run check",
    "postinstall": "node hooks/install.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "knip": "^6.43.0",
    "oxlint": "catalog:"
  }
}
