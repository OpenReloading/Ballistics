{
  "name": "openreloading",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/schema",
    "packages/importers",
    "packages/core",
    "packages/data",
    "packages/api",
    "packages/drawing",
    "apps/docs",
    "apps/web",
    "tools",
    "apps/e2e"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "lint": "biome check --error-on-warnings .",
    "format": "biome check --write .",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test -w @open-reloading/schema -w @open-reloading/core -w @open-reloading/importers -w @open-reloading/drawing -w @open-reloading/data -w @open-reloading/api -w @open-reloading/web -w @open-reloading/docs -w @open-reloading/tools && npm run test:unit -w @open-reloading/e2e",
    "test:e2e": "npm test -w @open-reloading/e2e",
    "e2e:smoke": "npm run smoke -w @open-reloading/e2e",
    "pages:build": "npm run pages -w @open-reloading/tools",
    "pages:serve": "npm run pages:serve -w @open-reloading/tools",
    "data:validate": "npm run validate -w @open-reloading/data",
    "api:check": "npm run api-check -w @open-reloading/tools",
    "api:conformance": "npm run api-conformance -w @open-reloading/tools",
    "deps:check": "depcruise packages/core/src packages/drawing/src packages/importers/src packages/importers/dist packages/schema/src packages/data/src packages/api/src apps/web/src --config .dependency-cruiser.cjs --output-type err",
    "knip": "knip",
    "docs:check": "npm run check -w @open-reloading/docs",
    "postinstall": "node patches/apply.mjs && node hooks/install.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@swc/core": "^1.16.20",
    "dependency-cruiser": "^18.7.0",
    "knip": "^6.43.0"
  },
  "overrides": {
    "@docusaurus/core": {
      "tinypool": "^2.1.2"
    },
    "katex": "0.19.0",
    "postcss-selector-parser": "^7.1.6",
    "serialize-javascript": "^7.1.3",
    "sockjs": {
      "uuid": "^11.1.1"
    }
  }
}
